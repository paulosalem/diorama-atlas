{
  "name": "diorama-atlas",
  "version": "1.0.0",
  "description": "An interactive globe of culturally inspired, full-scale Three.js interiors and outdoor environments.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "node --watch src/server/index.mjs",
    "start": "node src/server/index.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "capture:interiors": "node scripts/capture-interiors.mjs",
    "compare:interiors": "node scripts/build-comparison.mjs",
    "previews:publish": "node scripts/publish-previews.mjs",
    "test:outdoors": "node scripts/check-outdoors.mjs",
    "test:water-prints": "node scripts/check-water-prints.mjs",
    "build:prints": "python scripts/helpers/build-print-library.py",
    "build:credits": "node scripts/build-credits.mjs",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "openai": "^6.27.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "eslint": "^10.10.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1"
  }
}
